{
  "workspaces": [
    "packages/*"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "dependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@tabnews/forms": "workspace:*",
    "@tabnews/helpers": "workspace:*",
    "@tabnews/hooks": "workspace:*",
    "@tabnews/infra": "workspace:*",
    "@tabnews/ui": "workspace:*",
    "async-retry": "1.3.3",
    "bcryptjs": "3.0.3",
    "clsx": "2.1.1",
    "cookie": "1.1.1",
    "date-fns": "4.4.0",
    "feed": "5.2.1",
    "is-in-subnet": "4.0.1",
    "joi": "18.2.1",
    "next": "16.2.11",
    "next-connect": "1.0.0",
    "next-swr": "0.2.0-canary.0",
    "node-pg-migrate": "8.0.4",
    "nodemailer": "8.0.10",
    "nprogress": "0.2.0",
    "parse-link-header": "2.0.0",
    "pg": "8.21.0",
    "react": "19.2.6",
    "react-confetti": "6.4.0",
    "react-content-loader": "7.1.2",
    "react-dom": "19.2.6",
    "react-email": "6.5.0",
    "react-icons": "5.6.0",
    "react-rewards": "2.1.0",
    "recharts": "3.8.1",
    "remove-markdown": "0.6.4",
    "resend": "6.12.4",
    "satori": "0.26.0",
    "slug": "11.0.1",
    "snakeize": "0.1.0",
    "swr": "2.4.1",
    "vis-network": "10.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.0.2",
    "@commitlint/config-conventional": "21.0.2",
    "@commitlint/cz-commitlint": "21.0.2",
    "@faker-js/faker": "10.4.0",
    "@react-email/ui": "6.5.0",
    "@tabnews/config": "workspace:*",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@vitest/coverage-v8": "4.1.7",
    "concurrently": "10.0.0",
    "dotenv": "17.4.2",
    "dotenv-expand": "13.0.0",
    "kill-port": "1.6.1",
    "npm-package-json-lint": "10.4.0",
    "set-cookie-parser": "3.1.0",
    "uuid": "14.0.0",
    "vitest": "4.1.7"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "vercel-build": "npm run migrate && npm run admin:create && next build",
    "migrate": "node-pg-migrate up -m infra/migrations/",
    "admin:create": "node infra/scripts/create-admin.js",
    "lint": "eslint . --max-warnings 0",
    "db:up": "docker compose up -d",
    "local:migrate": "node --env-file=.env.development node_modules/node-pg-migrate/bin/node-pg-migrate.js up -m infra/migrations/",
    "local:admin": "node --env-file=.env.development infra/scripts/create-admin.js",
    "local:setup": "npm run db:up && npm run local:migrate && npm run local:admin"
  },
  "engines": {
    "node": "24.x",
    "npm": ">=11.10.0"
  },
  "name": "medialake",
  "description": "Conteúdos para quem vive de programação e tecnologia.",
  "version": "1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/filipedeschamps/tabnews.com.br.git"
  },
  "keywords": [
    "news"
  ],
  "author": "Filipe Deschamps",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/filipedeschamps/tabnews.com.br/issues"
  },
  "homepage": "https://www.tabnews.com.br/",
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  },
  "npmpackagejsonlint": {
    "rules": {
      "prefer-absolute-version-dependencies": [
        "error",
        {
          "exceptions": [
            "@tabnews/forms",
            "@tabnews/helpers",
            "@tabnews/hooks",
            "@tabnews/infra",
            "@tabnews/ui"
          ]
        }
      ],
      "prefer-absolute-version-devDependencies": [
        "error",
        {
          "exceptions": [
            "@tabnews/config"
          ]
        }
      ]
    }
  }
}
